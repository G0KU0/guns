<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guns.lol Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-body: #09090b; --bg-sidebar: #000; --bg-card: #121212; --bg-input: #1a1a1a;
            --border: #27272a; --primary: #8b5cf6; --text-main: #fff; --text-muted: #a1a1aa;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: var(--bg-body); color: var(--text-main); height: 100vh; display: flex; overflow: hidden; }
        
        /* Sidebar */
        .sidebar { width: 260px; background: var(--bg-sidebar); border-right: 1px solid var(--border); padding: 24px; display: flex; flex-direction: column; }
        .logo { font-size: 1.25rem; font-weight: 800; margin-bottom: 30px; display: flex; align-items: center; gap: 10px; } .logo i { color: var(--primary); }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 10px; color: var(--text-muted); text-decoration: none; border-radius: 8px; margin-bottom: 5px; font-weight: 500; transition: 0.2s; }
        .nav-item:hover { background: rgba(255,255,255,0.05); color: white; }
        .nav-item.active { background: rgba(139, 92, 246, 0.1); color: var(--primary); }
        
        /* Main Content */
        .main-content { flex: 1; overflow-y: auto; padding: 32px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .btn-view { background: var(--bg-card); border: 1px solid var(--border); color: white; padding: 8px 16px; border-radius: 8px; text-decoration: none; }
        
        /* Assets Grid */
        .section-header { font-weight: 600; color: var(--text-muted); margin: 30px 0 15px 0; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px; }
        .assets-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
        .asset-box { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; gap: 10px; transition: 0.2s; }
        .asset-box:hover { border-color: var(--primary); }
        .asset-label { font-size: 0.85rem; font-weight: 600; }
        .styled-input { width: 100%; background: var(--bg-input); border: 1px solid var(--border); color: var(--text-main); padding: 10px; border-radius: 8px; font-size: 0.9rem; }
        .styled-input:focus { outline: none; border-color: var(--primary); }

        /* General Form */
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px; }
        .btn-save { background: white; color: black; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 700; cursor: pointer; float: right; margin-top: 30px; transition: 0.2s; }
        .btn-save:hover { background: var(--primary); color: white; }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="logo"><i class="fa-solid fa-gun"></i> guns.lol</div>
        <a href="#" class="nav-item active"><i class="fa-solid fa-pen-ruler"></i> Customize</a>
        <a href="#" class="nav-item"><i class="fa-solid fa-link"></i> Links</a>
        <a href="/logout" class="nav-item" style="color: #ef4444; margin-top: auto;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </aside>

    <main class="main-content">
        <div class="header">
            <h2>Customize</h2>
            <a href="/<%= user.username %>" target="_blank" class="btn-view"><i class="fa-solid fa-eye"></i> View Page</a>
        </div>

        <form action="/dashboard" method="POST">
            
            <div class="section-header" style="margin-top: 0;">Assets Uploader</div>
            <div class="assets-grid">
                <div class="asset-box">
                    <div class="asset-label"><i class="fa-regular fa-image"></i> Background URL</div>
                    <input type="text" name="backgroundUrl" class="styled-input" value="<%= user.backgroundUrl %>" placeholder="https://...">
                </div>
                <div class="asset-box">
                    <div class="asset-label"><i class="fa-regular fa-user"></i> Avatar URL</div>
                    <input type="text" name="avatarUrl" class="styled-input" value="<%= user.avatarUrl %>" placeholder="https://...">
                </div>
                <div class="asset-box">
                    <div class="asset-label"><i class="fa-solid fa-music"></i> Music URL (MP3)</div>
                    <input type="text" name="musicUrl" class="styled-input" value="<%= user.musicUrl %>" placeholder="https://...">
                </div>
                <div class="asset-box">
                    <div class="asset-label"><i class="fa-solid fa-mouse-pointer"></i> Cursor URL (PNG)</div>
                    <input type="text" name="cursorUrl" class="styled-input" value="<%= user.cursorUrl %>" placeholder="https://...">
                </div>
            </div>

            <div class="section-header">General Customization</div>
            <div class="asset-box" style="display: block;">
                <div class="form-row">
                    <div>
                        <div class="asset-label" style="margin-bottom:8px;">Bio / Description</div>
                        <input type="text" name="bio" class="styled-input" value="<%= user.bio %>">
                    </div>
                    <div>
                        <div class="asset-label" style="margin-bottom:8px;">"Click to Enter" Text</div>
                        <input type="text" name="clickToEnterText" class="styled-input" value="<%= user.clickToEnterText %>">
                    </div>
                </div>
                <div class="form-row">
                    <div>
                        <div class="asset-label" style="margin-bottom:8px;">Text Color</div>
                        <input type="color" name="themeColor" value="<%= user.themeColor %>" style="width: 100%; height: 40px; background: none; border: none;">
                    </div>
                </div>
            </div>

            <div class="section-header">Social Links</div>
            <div class="assets-grid">
                <input type="text" name="discord" class="styled-input" value="<%= user.discord %>" placeholder="Discord URL">
                <input type="text" name="instagram" class="styled-input" value="<%= user.instagram %>" placeholder="Instagram URL">
                <input type="text" name="tiktok" class="styled-input" value="<%= user.tiktok %>" placeholder="TikTok URL">
                <input type="text" name="youtube" class="styled-input" value="<%= user.youtube %>" placeholder="YouTube URL">
                <input type="text" name="telegram" class="styled-input" value="<%= user.telegram %>" placeholder="Telegram URL">
            </div>

            <button type="submit" class="btn-save">Save Changes</button>
            <div style="height: 50px;"></div>
        </form>
    </main>
</body>
</html>
